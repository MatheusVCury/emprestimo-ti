# Variáveis conforme ADR-001 (docs/adr/001-stack.md).
# Nunca commitar .env com valores reais.

# --- API (NestJS) ---
NODE_ENV=development
PORT=3000

# Prisma / Postgres (Supabase)
# Conexão de runtime: Supavisor, pooler, obrigatório connection_limit=1 em serverless
DATABASE_URL="postgresql://postgres:<password>@<project-ref>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexão de migration: direta, usada só por `prisma migrate deploy`
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Supabase Auth — validação de JWT via JWKS
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_JWT_ISSUER="https://<project-ref>.supabase.co/auth/v1"
SUPABASE_JWKS_URL="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"
# service_role — somente na API, nunca no bundle do front
SUPABASE_SERVICE_ROLE_KEY=

# CORS — allowlist da origem do front
CORS_ORIGIN="https://<front>.vercel.app"

# Sentry (API)
SENTRY_DSN=

# --- Frontend (Vite) ---
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY=

# Base da API para o cliente gerado a partir do openapi.json
VITE_API_BASE_URL="https://<api>.vercel.app/v1"

# Sentry (front)
VITE_SENTRY_DSN=
